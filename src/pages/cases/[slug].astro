---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cases as caseRecords } from '../../data/cases.js';
import { caseDetails } from '../../data/case-details.js';
export function getStaticPaths() {
  return caseRecords.map(c => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params;
const props = { title: '案例详情' };
const base = import.meta.env.BASE_URL;
const details = {
  xicun: { title:'西村·贝森大院', year:'2012', location:'四川·成都', architect:'刘家琨', cover:`${base}uploadfile/202510/7066a36637ccba5.jpg`,
    content:`西村大院的设计——反中心体量集合的城市综合体常见模式，采用外环内空的布局，环绕街区沿边修建，围合出一个公园般的超大院落。大、中、小竹林院落层层相套，面向公众开放，自由穿行，再现传统生活环境，激发集体记忆，延续了本地人民热爱的竹下休闲传统生活方式。功能设施式的骨架设计，任由富于个性的世俗生活自由填充，又被大院的巨大尺度所归纳，最终形成"市井立面"，传达出群体创造的丰富表现力。一条架空休闲跑道巡遊大院并攀升至屋顶又环绕一周，为跑步和骑车人们带来了自由兴奋的超常体验，并赋予建筑具有动态能量的鲜活形象。`
  },
  jishou: { title:'吉首美术馆', year:'2019', location:'湖南·吉首', architect:'张永和', cover:`${base}uploadfile/202508/cd1d797821bf190.jpg`,
    content:`美术馆所在的吉首市是湘西土家族苗族自治州的州府。建筑师建议将美术馆设立在人口密集的乾州古城的中心区，认为文化设施应该尽可能地方便居民使用。穿城而过的万溶江流经吉首的核心地带，因此构想了一座横跨江面、兼做步行桥的美术馆。被称作风雨桥的廊桥在我国山区里有着悠久的历史，作为对这一古老建筑类型的当代诠释，设计在保持传统廊桥的交通与歇脚功能的同时引入新的艺术内容。美术馆以桥上桥的形式构成。下层的钢桥是开放的桁架结构，为行人通过提供了一个带顶的街道；上层的现浇混凝土拱桥内部设有画廊。`
  },
  chunyuan: { title:'春园', year:'2018', location:'江苏·宜兴', architect:'葛明', cover:`${base}uploadfile/202508/bedf65a02143d5.jpg`,
    content:`春园用地窄而长，采用"半园半房"这一"型"——以房中有园、园中含房的方式回应场地。以4个坡顶不断起落构成一组复坡，各个坡顶彼此交叠形成一系列或高或低的覆盖和覆盖之中的留白，形成了场地上的特殊而细致的架构。春园里采用了特定的坡法以形成分节，通过4个坡顶互相连接、盖水土，而那些在上部的连接则隐藏于阴影之中。为了实现分节和连续，还需要真实建构和形式建构的配合，各个坡顶各有其空间特征。`
  }
};
const record = caseRecords.find(c => c.slug === slug);
const data = details[slug] || (record ? { ...record, cover: `${base}${record.cover}` } : { title: slug, year:'', location:'', architect:'', cover:'' });
const remoteDetail = caseDetails[slug];
---
<BaseLayout {...props}>
  <div class="max-w-4xl mx-auto px-6 py-24">
    <a href={`${base}cases`} class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-[#0f3460] mb-8 transition-colors">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      返回案例列表
    </a>
    <img src={data.cover} alt={data.title} class="w-full max-h-96 object-cover rounded-2xl mb-10" />
    <h1 class="text-3xl md:text-4xl font-black mb-4">{data.title}</h1>
    <div class="flex flex-wrap gap-3 text-sm text-gray-500 mb-10">
      {data.architect && <span class="tag bg-blue-50 text-blue-700">建筑师：{data.architect}</span>}
      {data.year && <span class="tag bg-gray-50 text-gray-600">{data.year}年</span>}
      {data.location && <span class="tag bg-gray-50 text-gray-600">{data.location}</span>}
    </div>
    {remoteDetail?.contentHtml ? (
      <div class="article text-lg leading-relaxed text-gray-600" set:html={remoteDetail.contentHtml}></div>
    ) : data.content ? (
      <div class="article text-lg leading-relaxed text-gray-600 space-y-4">
        {data.content.split('\n').map(p => <p>{p}</p>)}
      </div>
    ) : (
      <div class="text-center py-20 text-gray-400">
        <div class="text-5xl mb-4">🏛️</div>
        <p class="text-lg">详细信息整理中</p>
        <p class="text-sm mt-2">建筑年份：{data.year} · 地点：{data.location} · 建筑师：{data.architect}</p>
      </div>
    )}
    <div class="mt-16 text-center">
      <a href={`${base}cases`} class="btn-primary text-base px-8 py-3.5">返回案例列表</a>
    </div>
  </div>
</BaseLayout>
