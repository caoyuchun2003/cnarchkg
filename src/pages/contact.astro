---
import BaseLayout from '../layouts/BaseLayout.astro';
const props = { title: '联系我们' };
const base = import.meta.env.BASE_URL;
---
<BaseLayout {...props}>
  <div class="container-page py-24 max-w-2xl mx-auto">
    <h1 class="section-title">联系我们</h1>
    <div class="card p-10 space-y-6">
      <div>
        <div class="text-sm text-gray-400 mb-1">单位</div>
        <div class="font-bold text-xl">天津大学建筑学院 · 11建筑工作室</div>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <div class="text-sm text-gray-400 mb-1">地址</div>
          <div class="font-medium">天津市南开区卫津路92号<br/>天津大学建筑学院五层</div>
        </div>
        <div>
          <div class="text-sm text-gray-400 mb-1">联系方式</div>
          <div class="font-medium">📱 18636809695</div>
          <div class="font-medium mt-1">📧 jianghan618@tju.edu.cn</div>
        </div>
      </div>
      <hr class="border-gray-100" />
      <div class="text-sm text-gray-400">11 Studio · School of Architecture, Tianjin University<br/>5/F, No.92 Weijin Road, Nankai District, Tianjin, China</div>
    </div>
  </div>
</BaseLayout>