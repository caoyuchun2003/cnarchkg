---
import BaseLayout from '../layouts/BaseLayout.astro';
const props = { title: '课题组成员' };
const base = import.meta.env.BASE_URL;
const members = [
  { name: '孔宇航', title: '讲席教授', avatar: `${base}image/001@2x.png` },
  { name: '王其亨', title: '教授', avatar: `${base}image/Bitmap@2x(3).png` },
  { name: '李华', title: '教授', avatar: `${base}image/Bitmap@2x(5).png` },
  { name: '汪丽君', title: '教授', avatar: `${base}image/Bitmap@2x(7).png` },
  { name: '张春彦', title: '教授', avatar: `${base}image/Bitmap@2x(11).png` },
  { name: '张凤梧', title: '教授', avatar: `${base}image/Bitmap@2x(15).png` },
  { name: '杨菁', title: '副教授', avatar: `${base}image/Bitmap@2x(9).png` },
  { name: '沈旸', title: '教授', avatar: `${base}image/Bitmap@2x(13).png` },
  { name: '胡一可', title: '教授', avatar: `${base}image/Bitmap@2x(17).png` },
  { name: '辛善超', title: '副教授', avatar: `${base}image/Bitmap@2x(1).png` },
];
const leader = members[0];
const otherMembers = members.slice(1);
---
<BaseLayout {...props}>
  <div class="container-page py-24">
    <h1 class="section-title">课题组成员</h1>
    <div class="grid lg:grid-cols-[minmax(220px,2fr)_minmax(0,3fr)] gap-10 max-w-6xl mx-auto items-start">
      <div class="text-center relative">
        <div class="absolute top-3 right-3 z-10 px-2.5 py-1 rounded-full bg-[#0f3460] text-white text-[10px] font-bold tracking-wide">项目负责人</div>
        <div class="aspect-[3/4] mb-3 overflow-hidden rounded-2xl bg-gray-50">
          <img src={leader.avatar} alt={leader.name} class="w-full h-full object-cover grayscale hover:grayscale-0 hover:scale-105 transition-all duration-300 ring-4 ring-[#0f3460]/10" loading="lazy" />
        </div>
        <div class="text-xl text-[#0f3460] font-medium">{leader.name}（{leader.title}）</div>
        <div class="mt-2 text-xs font-medium text-[#0f3460]/70">国家自然科学基金重点项目负责人</div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-8">
        {otherMembers.map(m => (
          <div class="text-center">
            <div class="aspect-square mb-3 overflow-hidden rounded-2xl bg-gray-50">
              <img src={m.avatar} alt={m.name} class="w-full h-full object-cover grayscale hover:grayscale-0 hover:scale-105 transition-all duration-300" loading="lazy" />
            </div>
            <div class="text-sm text-gray-600 font-medium">{m.name}（{m.title}）</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
