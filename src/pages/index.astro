---
import BaseLayout from '../layouts/BaseLayout.astro';
const props = { title: '首页' };
const base = import.meta.env.BASE_URL;
const items = [
  ['📖', '课题简介', 'about', '了解研究背景、目标与方法'],
  ['👥', '课题组成员', 'team', '核心研究团队介绍'],
  ['🏛️', '转译案例', 'cases', '20个经典建筑案例解析'],
  ['🔗', '知识图谱', 'kg', '交互式知识网络可视化'],
  ['🎨', '传统原型', 'prototypes', '历史建筑原型图集'],
  ['📚', '现有成果', 'results', '专著·论文·专利·展览'],
  ['📧', '联系我们', 'contact', '天津大学建筑学院'],
];
---
<BaseLayout {...props}>
  <!-- Hero -->
  <section class="hero-section py-24 md:py-36">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <div class="inline-block mb-6">
        <span class="tag text-sm px-4 py-1.5">NSFC 重点项目 · 52038007</span>
      </div>
      <h1 class="hero-title mb-6">中华营建 · 知识图谱</h1>
      <p class="text-lg md:text-xl text-gray-500 max-w-3xl mx-auto leading-relaxed mb-10">
        国家自然科学基金重点项目：基于中华语境"建筑-人-环境"融贯机制的当代营建体系重构研究
      </p>
      <div class="flex justify-center gap-4">
        <a href={`${base}about`} class="btn-primary">了解课题</a>
        <a href={`${base}cases`} class="px-6 py-3 rounded-xl border border-gray-200 text-gray-600 font-medium text-sm hover:border-[#0f3460] hover:text-[#0f3460] transition-colors">浏览案例</a>
      </div>
    </div>
  </section>
  <!-- Grid -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {items.slice(0,4).map(([icon, label, href, desc]) => (
        <a href={`${base}${href}`} class="card p-6 text-center group">
          <div class="text-4xl mb-3">{icon}</div>
          <div class="font-bold text-lg mb-1 group-hover:text-[#0f3460] transition-colors">{label}</div>
          <div class="text-sm text-gray-400">{desc}</div>
        </a>
      ))}
    </div>
    <div class="grid grid-cols-3 gap-4 mt-4">
      {items.slice(4).map(([icon, label, href, desc]) => (
        <a href={`${base}${href}`} class="card p-6 text-center group">
          <div class="text-4xl mb-3">{icon}</div>
          <div class="font-bold text-lg mb-1 group-hover:text-[#0f3460] transition-colors">{label}</div>
          <div class="text-sm text-gray-400">{desc}</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>