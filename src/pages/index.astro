---
import BaseLayout from '../layouts/BaseLayout.astro';
const props = { title: '首页' };
const base = import.meta.env.BASE_URL;
---
<BaseLayout {...props}>
  <section class="h-[60vh] relative flex items-center justify-center bg-gray-50">
    <div class="text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">中华营建 · 知识图谱</h1>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto px-4">
        国家自然科学基金重点项目：基于中华语境"建筑-人-环境"融贯机制的当代营建体系重构研究
      </p>
      <p class="text-sm text-gray-400 mt-4">(52038007)</p>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <a href={`${base}about`} class="p-8 border rounded-xl hover:shadow-lg transition-shadow text-center">
        <div class="text-3xl mb-3">📖</div>
        <div class="font-bold">课题简介</div>
      </a>
      <a href={`${base}team`} class="p-8 border rounded-xl hover:shadow-lg transition-shadow text-center">
        <div class="text-3xl mb-3">👥</div>
        <div class="font-bold">课题组成员</div>
      </a>
      <a href={`${base}cases`} class="p-8 border rounded-xl hover:shadow-lg transition-shadow text-center">
        <div class="text-3xl mb-3">🏛</div>
        <div class="font-bold">转译案例</div>
      </a>
      <a href={`${base}kg`} class="p-8 border rounded-xl hover:shadow-lg transition-shadow text-center">
        <div class="text-3xl mb-3">🔗</div>
        <div class="font-bold">知识图谱</div>
      </a>
      <a href={`${base}prototypes`} class="p-8 border rounded-xl hover:shadow-lg transition-shadow text-center">
        <div class="text-3xl mb-3">🏛</div>
        <div class="font-bold">传统原型</div>
      </a>
      <a href={`${base}results`} class="p-8 border rounded-xl hover:shadow-lg transition-shadow text-center">
        <div class="text-3xl mb-3">📚</div>
        <div class="font-bold">现有成果</div>
      </a>
      <a href={`${base}contact`} class="p-8 border rounded-xl hover:shadow-lg transition-shadow text-center">
        <div class="text-3xl mb-3">📧</div>
        <div class="font-bold">联系我们</div>
      </a>
    </div>
  </section>
</BaseLayout>