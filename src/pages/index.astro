---
import BaseLayout from '../layouts/BaseLayout.astro';
const props = { title: '首页' };
const base = import.meta.env.BASE_URL;
const featuredCases = [
  { slug: 'xicun', title: '西村·贝森大院', location: '四川·成都', year: '2012', architect: '刘家琨', cover: `${base}uploadfile/202510/7066a36637ccba5.jpg` },
  { slug: 'jishou', title: '吉首美术馆', location: '湖南·吉首', year: '2019', architect: '张永和', cover: `${base}uploadfile/202508/cd1d797821bf190.jpg` },
  { slug: 'xiangshan', title: '香山饭店', location: '北京', year: '1982', architect: '贝聿铭', cover: `${base}uploadfile/202509/5be05375f87a3e6.jpg` },
  { slug: 'hangzhou', title: '杭州国家版本馆', location: '浙江·杭州', year: '2022', architect: '王澍', cover: `${base}uploadfile/202509/086b5382a4eec13.png` },
];
const navCards = [
  ['📖', '课题简介', '了解研究背景与技术路线', 'about'],
  ['👥', '课题组成员', '核心研究团队介绍', 'team'],
  ['🏛️', '转译案例', '20 个精选建筑案例', 'cases'],
  ['🔗', '知识图谱', '交互式知识网络可视化', 'kg'],
  ['🎨', '传统原型', '历史建筑原型图像档案', 'prototypes'],
  ['📚', '现有成果', '专著·论文·专利·展览', 'results'],
];
const timelineItems = [
  ['2023', '课题启动', '获批国家自然科学基金重点项目'],
  ['2024', '数据采集', '完成传统营建知识库建设'],
  ['2025', '图谱构建', '上线知识图谱交互平台'],
  ['2026', '成果汇总', '专著出版、展览参展、论文发表'],
];
---
<BaseLayout {...props}>
  <!-- Hero with Canvas background -->
  <section class="hero-bg min-h-[90vh] flex items-center relative">
    <canvas id="kg-canvas"></canvas>
    <div class="floating-shape shape-1"></div>
    <div class="floating-shape shape-2"></div>
    <div class="floating-shape shape-3"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-6 py-24 md:py-32 text-center">
      <div class="animate-fade-up">
        <span class="inline-block px-5 py-2 rounded-full text-sm font-semibold bg-white/80 backdrop-blur border border-gray-100 text-[#0f3460] mb-8 shadow-sm">
          NSFC 重点项目 · 52038007
        </span>
      </div>
      <div class="hero-title-wrap" style="animation: fade-in-up 0.8s ease-out 0.15s both;">
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-[-0.03em] leading-[1.05] mb-8" style="color:#1a1a2e;">
          中华营建<br/>
          <span style="background:linear-gradient(135deg,#0f3460,#4a6fa5,#16213e);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">知识图谱</span>
        </h1>
      </div>
      <p class="text-lg md:text-xl text-gray-500 max-w-2xl mx-auto leading-relaxed mb-10" style="animation: fade-in-up 0.8s ease-out 0.3s both;">
        以数据挖掘与知识图谱技术，系统整合中华传统营建智慧<br/>构建"建筑-人-环境"融贯机制的认知框架
      </p>
      <div class="flex justify-center gap-4" style="animation: fade-in-up 0.8s ease-out 0.45s both;">
        <a href={`${base}about`} class="btn-primary text-base px-8 py-3.5">了解课题</a>
        <a href={`${base}kg`} class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl border-2 border-[#0f3460]/20 text-[#0f3460] font-medium text-base hover:border-[#0f3460] hover:bg-[#0f3460]/5 transition-all duration-300">
          探索图谱
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
    <div class="absolute bottom-8 inset-x-0 flex justify-center z-20" style="animation: fade-in-up 0.8s ease-out 0.6s both;">
      <div class="flex flex-col items-center gap-2 text-gray-400 text-xs">
        <div class="w-5 h-8 rounded-full border-2 border-gray-300 flex justify-center pt-1.5"><div class="w-1 h-2 rounded-full bg-gray-400 animate-bounce"></div></div>
        <span>向下探索</span>
      </div>
    </div>
  </section>

  <!-- Stats with counter animation -->
  <section class="py-16 max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 glow-border">
      {[
        ['20', '经典案例', '建筑转译实践'],
        ['4', '知识图谱', '交互式可视化'],
        ['100+', '学术论文', '核心期刊发表'],
        ['10', '团队成员', '教授/副教授'],
      ].map(([num,label,sub],i) => (
        <div class="text-center px-4 py-8" style={`animation: fade-in-up 0.6s ease-out ${0.5+i*0.1}s both;`}>
          <div class="text-4xl md:text-5xl font-black text-[#0f3460] mb-2" data-count={num.replace('+','')} data-suffix={num.includes('+')?'+':''}>{num}</div>
          <div class="font-bold text-sm">{label}</div>
          <div class="text-xs text-gray-400 mt-1">{sub}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Pipeline -->
  <section class="py-24 bg-white reveal">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="section-title">研究方法</h2>
      <div class="flex justify-center overflow-x-auto">
        <svg viewBox="0 0 800 200" class="w-full max-w-3xl">
          <!-- Static background lines -->
          <line x1="80" y1="100" x2="180" y2="100" stroke="rgba(15,52,96,0.15)" stroke-width="2" stroke-linecap="round"/>
          <line x1="280" y1="100" x2="380" y2="100" stroke="rgba(15,52,96,0.15)" stroke-width="2" stroke-linecap="round"/>
          <line x1="480" y1="100" x2="580" y2="100" stroke="rgba(15,52,96,0.15)" stroke-width="2" stroke-linecap="round"/>
          <line x1="680" y1="100" x2="750" y2="100" stroke="rgba(15,52,96,0.15)" stroke-width="2" stroke-linecap="round"/>
          <!-- Animated overlay lines -->
          <line x1="80" y1="100" x2="180" y2="100" class="pipe-line-active" stroke="#0f3460" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="150" stroke-dashoffset="150"/>
          <line x1="280" y1="100" x2="380" y2="100" class="pipe-line-active" stroke="#0f3460" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="150" stroke-dashoffset="150"/>
          <line x1="480" y1="100" x2="580" y2="100" class="pipe-line-active" stroke="#0f3460" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="150" stroke-dashoffset="150"/>
          <line x1="680" y1="100" x2="750" y2="100" class="pipe-line-active" stroke="#0f3460" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="150" stroke-dashoffset="150"/>
          <!-- Arrowheads -->
          <polygon points="175,94 195,100 175,106" fill="rgba(15,52,96,0.3)"/>
          <polygon points="375,94 395,100 375,106" fill="rgba(15,52,96,0.3)"/>
          <polygon points="575,94 595,100 575,106" fill="rgba(15,52,96,0.3)"/>
          <!-- Nodes -->
          <circle cx="80" cy="100" r="28" fill="white" stroke="rgba(15,52,96,0.3)" stroke-width="1.5"/>
          <text x="80" y="106" text-anchor="middle" font-size="13" font-weight="800" fill="#0f3460">数据</text>
          <circle cx="280" cy="100" r="28" fill="white" stroke="rgba(15,52,96,0.3)" stroke-width="1.5"/>
          <text x="280" y="106" text-anchor="middle" font-size="13" font-weight="800" fill="#0f3460">挖掘</text>
          <circle cx="480" cy="100" r="28" fill="white" stroke="rgba(15,52,96,0.3)" stroke-width="1.5"/>
          <text x="480" y="106" text-anchor="middle" font-size="13" font-weight="800" fill="#0f3460">图谱</text>
          <circle cx="680" cy="100" r="28" fill="white" stroke="rgba(15,52,96,0.3)" stroke-width="1.5"/>
          <text x="680" y="106" text-anchor="middle" font-size="13" font-weight="800" fill="#0f3460">转译</text>
          <circle cx="760" cy="100" r="28" fill="white" stroke="rgba(15,52,96,0.3)" stroke-width="1.5"/>
          <text x="760" y="106" text-anchor="middle" font-size="13" font-weight="800" fill="#0f3460">导控</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-24 bg-[#fafafb] reveal">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="section-title">课题历程</h2>
      <div class="relative">
        <div class="timeline-line absolute left-1/2 top-0 bottom-0 w-px -translate-x-1/2"></div>
        {timelineItems.map(([year, title, desc], i) => (
          <div class={`flex items-center mb-8 ${i%2===0?'md:flex-row':'md:flex-row-reverse'} flex-row`}>
            <div class={`flex-1 ${i%2===0?'md:text-right md:pr-10':'md:text-left md:pl-10'} pr-6`}>
              <div class="font-black text-2xl text-[#0f3460] mb-1">{year}</div>
              <div class="font-bold text-lg">{title}</div>
              <div class="text-sm text-gray-500">{desc}</div>
            </div>
            <div class="relative flex-shrink-0 w-4 h-4"><div class="timeline-dot relative"></div></div>
            <div class="flex-1 hidden md:block"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nav Cards with 3D tilt -->
  <section class="py-24 max-w-5xl mx-auto px-6 reveal">
    <h2 class="section-title">探索营建智慧</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {navCards.map(([icon,label,desc,href],i) => (
        <a href={`${base}${href}`} class="card p-7 group flex items-start gap-5 card-3d" style={`animation: fade-in-up 0.5s ease-out ${i*0.08}s both;`}>
          <div class="text-4xl shrink-0">{icon}</div>
          <div>
            <div class="font-bold text-xl mb-1 group-hover:text-[#0f3460] transition-colors">{label}</div>
            <div class="text-sm text-gray-400 leading-relaxed">{desc}</div>
          </div>
          <div class="ml-auto self-center text-gray-300 group-hover:text-[#0f3460] group-hover:translate-x-1 transition-all duration-300">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured cases showcase -->
  <section class="py-24 bg-[#fafafb] reveal">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="section-title">精选案例</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredCases.map(c => (
          <a href={`${base}cases/${c.slug}`} class="card group card-3d">
            <img src={c.cover} alt={c.title} class="w-full h-52 object-cover" loading="lazy" />
            <div class="p-4">
              <div class="font-bold text-lg group-hover:text-[#0f3460] transition-colors">{c.title}</div>
              <div class="text-sm text-gray-500 mt-1">{c.location}</div>
              <div class="text-xs text-gray-400 mt-1">{c.architect} · {c.year}</div>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href={`${base}cases`} class="btn-primary text-base px-8 py-3.5">
          查看全部 20 个案例 → 
        </a>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="py-24 reveal">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <div class="text-4xl mb-6">📧</div>
      <h2 class="text-3xl font-black mb-4">联系我们</h2>
      <p class="text-gray-500 mb-8">天津大学建筑学院 · 11建筑工作室<br/>天津市南开区卫津路92号</p>
      <a href={`${base}contact`} class="btn-primary text-base px-8 py-3.5">获取更多信息</a>
    </div>
  </section>
</BaseLayout>

<!-- Load effects -->
<script src={`${base}scripts/effects.js`}></script>
