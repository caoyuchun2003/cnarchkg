---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const graphs = {
  'garden-kg': {
    title: '中国现当代建筑中的园林知识图谱',
    date: '2025-09-04',
    cover: `${base}uploadfile/202601/2a890bead7e36ed.jpg`,
    summary: '以园林议题对中国现当代建筑的知识形塑为出发点，通过梳理重要建筑学期刊的相关文献，将涉及的建筑作品、建筑师、评论家、关键词等信息及其构成的知识网络进行综合性可视化呈现。'
  },
  yuanmingyuan: {
    title: '圆明园“建筑-环境-行为-知觉”多维模式图谱',
    date: '2025-09-04',
    cover: `${base}uploadfile/202601/dd6c6141353a87b.jpg`,
    summary: '针对古典园林研究中“环境空间-行为感知”的融贯知识系统认知缺失，融合文本挖掘、层次聚类与空间分析等方法。'
  },
  'art-arch': {
    title: '中国现当代“建筑-艺术”互馈网络',
    date: '2025-08-07',
    cover: `${base}uploadfile/202601/883d9e0c853ec7a.jpg`,
    summary: '将建筑图绘放置于中国当代艺术的语境中考察，综合回顾建筑图绘与绘画、雕塑、装置等艺术形式的关联性。'
  },
  courtyard: {
    title: '中国现当代合院谱系图',
    date: '2025-08-07',
    cover: `${base}uploadfile/202601/1e2791c025113e0.png`,
    summary: '以转译与重构的视角对古代合院进行精读，探讨其内在图式、生成机制与建构方式。'
  }
};

export function getStaticPaths() {
  return ['garden-kg', 'yuanmingyuan', 'art-arch', 'courtyard']
    .map(slug => ({ params: { slug } }));
}

const graph = graphs[Astro.params.slug];
---
<BaseLayout title={graph.title}>
  <article class="max-w-4xl mx-auto px-6 py-24">
    <a href={`${base}kg`} class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-[#0f3460] mb-8 transition-colors">
      ← 返回知识图谱
    </a>
    <img src={graph.cover} alt={graph.title} class="w-full max-h-96 object-cover rounded-2xl mb-10" />
    <h1 class="text-3xl md:text-4xl font-black mb-4">{graph.title}</h1>
    <p class="text-sm text-gray-400 mb-8">更新日期：{graph.date}</p>
    <p class="text-lg leading-relaxed text-gray-600">{graph.summary}</p>
    <div class="card mt-10 p-8 text-center text-gray-400">
      <div class="text-4xl mb-3">🔗</div>
      <p>交互式图谱正在整理中</p>
    </div>
  </article>
</BaseLayout>
