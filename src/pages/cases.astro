const base = import.meta.env.BASE_URL;
const cases = [
  { slug: 'xicun', title: '西村·贝森大院', year: '2012', location: '四川·成都', architect: '刘家琨', cover: '/uploadfile/202510/7066a36637ccba5.jpg' },
  { slug: 'jishou', title: '吉首美术馆', year: '2019', location: '湖南·吉首', architect: '张永和', cover: '/uploadfile/202508/cd1d797821bf190.jpg' },
  { slug: 'chunyuan', title: '春园', year: '2018', location: '江苏·宜兴', architect: '葛明', cover: '/uploadfile/202508/bedf65a02143d5.jpg' },
  { slug: 'xixi', title: '习习山庄', year: '1982', location: '浙江·建德', architect: '葛如亮', cover: '/uploadfile/202509/672dde58b07885b.png' },
  { slug: 'xiangshan', title: '香山饭店', year: '1982', location: '北京', architect: '贝聿铭', cover: '/uploadfile/202509/5be05375f87a3e6.jpg' },
