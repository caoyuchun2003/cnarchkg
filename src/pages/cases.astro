---
<BaseLayout {...props}>
  <div class="max-w-7xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-12 text-center">转译案例</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {cases.map(c => (
        <a href={`${base}cases/${c.slug}`} class="group border rounded-xl overflow-hidden hover:shadow-lg transition-shadow">
          <img src={c.cover} alt={c.title} class="w-full h-48 object-cover" loading="lazy" />
          <div class="p-4">
            <h3 class="font-bold text-lg group-hover:text-blue-600 transition-colors">{c.title}</h3>
            <p class="text-sm text-gray-500 mt-1">{c.location}</p>
            <p class="text-xs text-gray-400 mt-1">{c.architect} · {c.year}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>