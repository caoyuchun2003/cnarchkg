  { slug: 'jinshanling', title: '金山岭上院', year: '2022', location: '河北·承德', architect: '柳亦春', cover: '/uploadfile/202509/75d03313adbcb.jpg' },
  { slug: 'anyang', title: '安阳殷墟博物馆', year: '2005', location: '河南·安阳', architect: '崔愷', cover: '/uploadfile/202509/368160eaca9daab.jpg' },
  { slug: 'xizang', title: '西藏非物质文化遗产博物馆', year: '2018', location: '西藏·拉萨', architect: '肖诚', cover: '/uploadfile/202509/f5fa2b0d00b3383.png' },
  { slug: 'fengdazhong', title: '冯大中艺术中心', year: '2010', location: '辽宁·本溪', architect: '陶磊', cover: '/uploadfile/202509/69107dce77b2627.jpg' },
  { slug: 'miaolu', title: '淼庐', year: '2019', location: '云南·丽江', architect: '李晓东', cover: '/uploadfile/202509/0e617dd495b919d.jpg' },
  { slug: 'hangzhou', title: '杭州国家版本馆', year: '2022', location: '浙江·杭州', architect: '王澍', cover: '/uploadfile/202509/086b5382a4eec13.png' },
  { slug: 'hongzhuan', title: '北京红砖美术馆', year: '2014', location: '北京', architect: '董豫赣', cover: '/uploadfile/202509/1666a584d3c99.jpg' },
  { slug: 'qufu', title: '曲阜阙里宾舍', year: '1985', location: '山东·曲阜', architect: '戴念慈', cover: '/uploadfile/202508/abe912377144d72.png' },
