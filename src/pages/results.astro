---
import BaseLayout from '../layouts/BaseLayout.astro';
const props = { title: '现有成果' };
const base = import.meta.env.BASE_URL;
const books = ['词语与建筑物：现代建筑的语汇','从衣集：历史空间与空间历史中的中国古代城市','Routledge Handbook of Chinese Architecture','丛华集：多维视角与多重价值中的中国遗产保护','建筑类型学（第三版）','河湟地区传统建筑研究','转译与重构'];
const exhibitions = ['第18届威尼斯国际建筑双年展参展','第17届威尼斯国际建筑双年展参展','2022年第九届深港城市建筑双城双年展','2021年北京国际设计周参展'];
const practices = ['梦回榆林-榆林梅花楼片区集群设计','昆山拉谷谷文化中心','乐之庭 四川凯州新城建筑集群设计14号地块'];
---
<BaseLayout {...props}>
  <div class="container-page py-24">
    <h1 class="section-title">现有成果</h1>
    <div class="max-w-4xl mx-auto space-y-16">
      <section>
        <h2 class="text-2xl font-black mb-6 flex items-center gap-3">📚 <span>专著</span></h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {books.map(b => <div class="card p-4 text-center text-sm font-medium">{b}</div>)}
        </div>
      </section>
      <section>
        <h2 class="text-2xl font-black mb-6 flex items-center gap-3">📄 <span>论文</span></h2>
        <p class="text-gray-500 mb-4">已发表核心期刊论文 100 余篇。</p>
        <a href={`${base}papers`} class="btn-primary">查看完整列表 →</a>
      </section>
      <section>
        <h2 class="text-2xl font-black mb-6 flex items-center gap-3">🎯 <span>展览</span></h2>
        <div class="grid md:grid-cols-2 gap-3">
          {exhibitions.map(e => <div class="card p-4 text-sm">{e}</div>)}
        </div>
      </section>
      <section>
        <h2 class="text-2xl font-black mb-6 flex items-center gap-3">🏗️ <span>实践</span></h2>
        <div class="grid md:grid-cols-3 gap-3">
          {practices.map(p => <div class="card p-4 text-sm">{p}</div>)}
        </div>
      </section>
      <section>
        <h2 class="text-2xl font-black mb-6 flex items-center gap-3">💡 <span>专利</span></h2>
        <div class="card p-6 space-y-3 text-sm text-gray-600">
          <p><strong>发明专利：</strong>一种生成合院式建筑单体形态的三维建模方法及系统</p>
          <p><strong>实用新型：</strong>一种建筑动态表皮用光伏组件联动装置</p>
          <p><strong>外观专利：</strong>盲道用引导标识 (2023303851424)</p>
          <p><strong>外观专利：</strong>光伏窗 (CN201930724397.2)</p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>