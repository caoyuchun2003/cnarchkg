---
import BaseLayout from '../layouts/BaseLayout.astro';
const props = { title: '知识图谱' };
const kGs = [
  { slug: 'garden-kg', title: '中国现当代建筑中的园林知识图谱', date: '2025-09-04', summary: '以园林议题对中国现当代建筑的知识形塑为出发点，通过梳理重要建筑学期刊的相关文献，将涉及的建筑作品、建筑师、评论家、关键词等信息及其构成的知识网络进行综合性可视化呈现。', cover: '/uploadfile/202601/2a890bead7e36ed.jpg', link: '/network_view.html' },
  { slug: 'yuanmingyuan', title: '圆明园"建筑-环境-行为-知觉"多维模式图谱', date: '2025-09-04', summary: '针对古典园林研究中"环境空间-行为感知"的融贯知识系统的认知缺失，融合文本挖掘、层次聚类与空间分析等方法。', cover: '/uploadfile/202601/dd6c6141353a87b.jpg', link: '/network_view.html' },
  { slug: 'art-arch', title: '中国现当代"建筑-艺术"互馈网络', date: '2025-08-07', summary: '将建筑图绘放置于中国当代艺术的语境中考察，综合回顾建筑图绘与绘画、雕塑、装置等艺术形式的关联性。', cover: '/uploadfile/202601/883d9e0c853ec7a.jpg',  },
  { slug: 'courtyard', title: '中国现当代合院谱系图', date: '2025-08-07', summary: '以转译与重构的视角对古代合院进行精读，探讨其内在图式、生成机制与建构方式。', cover: '/uploadfile/202601/1e2791c025113e0.png', },
];
---
<BaseLayout {...props}>
  <div class="max-w-7xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-12 text-center">知识图谱</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {kGs.map(k => (
        <a href={k.link ? k.link : `/kg/${k.slug}`} class="group border rounded-xl overflow-hidden hover:shadow-lg transition-shadow flex">
          <img src={k.cover} alt={k.title} class="w-48 h-48 object-cover shrink-0" loading="lazy" />
          <div class="p-6">
            <h3 class="font-bold text-xl group-hover:text-blue-600 transition-colors mb-2">{k.title}</h3>
            <p class="text-sm text-gray-600 mb-2">{k.summary}</p>
            <p class="text-xs text-gray-400">{k.date}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>